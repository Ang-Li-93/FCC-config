# whizard v3.0.3
#
# wzp6_ee_qq_ecm91p2 : e+e- -> Z/gamma* -> q qbar  HADRONIC INCLUSIVE over the 5
#   quark flavors (u,d,s,c,b) at sqrt(s) = 91.2 GeV, with ISR + beam-energy spread,
#   showered/hadronized by PYTHIA6 (the FCC "wzp6" chain).
#
# Hadronic-only, for the BNL_MAPS vertex-MAPS full-sim study:
#   - hadronic Z dominates vertex occupancy ~10x over leptonic;
#   - leptonic channels are intentionally NOT included here. In particular the
#     e+e- (Bhabha) channel produces a status-1 electron WITH daughter pointers
#     (beam = final electron identity) that ddsim/Geant4 reject ("stable particle
#     with daughters", DD4hep #1094) -- a generator-record issue, detector-
#     independent (CLD full sim fails on it too). To add mu/tau later, append
#     "+ (e2,E2) + (e3,E3)" (but NOT the ee channel).
#
# Vertex smearing is done at FULL-SIM level (ddsim --vertexSigma), NOT in the
# generator: MSTP(151)=0 here (Brieuc's recipe). See maps_steer.py.
#
# EventProducer (--typestdhep wzp6) TEMPLATE: do NOT set n_events/seed here;
# EventProducer prepends them and runs `whizard card.sin` -> proc.stdhep.
# Based on the per-flavor wzp6_ee_dd_ecm91p2.sin card (same beams/ISR/BES/tune).

model = SM

# Center of mass energy
sqrts = 91.2 GeV

# Hadronic inclusive: sum of the 5 same-flavor q qbar final states (full gamma*/Z,
# no restriction -- same as the standard FCC per-flavor Z@91 cards, summed).
# sindarin has no line-continuation char -- keep the process on one line.
process proc = e1, E1 => (u,U) + (d,D) + (s,S) + (c,C) + (b,B)

beams = e1, E1 => gaussian => isr
?keep_beams  = true
?keep_remnants = true

! beams = e1, E1 => gaussian
gaussian_spread1 = 0.132%
gaussian_spread2 = 0.132%


?isr_handler       = true
$isr_handler_mode = "recoil"
isr_alpha          = 0.0072993
isr_mass           = 0.000511


! Parton shower and hadronization
?ps_fsr_active          = true
?ps_isr_active          = false
?hadronization_active   = true
$shower_method          = "PYTHIA6"
!?ps_PYTHIA_verbose     = true


$ps_PYTHIA_PYGIVE = "MSTJ(28)=0; PMAS(25,1)=125.; PMAS(25,2)=0.4143E-02; MSTJ(41)=2; MSTU(22)=2000; PARJ(21)=0.40000; PARJ(41)=0.11000; PARJ(42)=0.52000; PARJ(81)=0.25000; PARJ(82)=1.90000; MSTJ(11)=3; PARJ(54)=-0.03100; PARJ(55)=-0.00200; PARJ(1)=0.08500; PARJ(3)=0.45000; PARJ(4)=0.02500; PARJ(2)=0.31000; PARJ(11)=0.60000; PARJ(12)=0.40000; PARJ(13)=0.72000; PARJ(14)=0.43000; PARJ(15)=0.08000; PARJ(16)=0.08000; PARJ(17)=0.17000; MSTP(3)=1;MSTP(71)=1; MSTP(151)=0; PARP(151)=5.96e-3 ; PARP(152)=23.8E-6; PARP(153)=0.397; PARP(154)=10.89"
# BNL_MAPS: MSTP(151)=0 -> NO generator-side vertex smearing (done at ddsim via
# SIM.vertexSigma, Brieuc's recipe). MSTJ(41)=2 = standard hadronic shower (QCD+QED).
# PARP(151-154) keep the FCC-ee Z luminous-region sizes (sigma x,y,z,t) for reference.



integrate (proc) { iterations = 10:100000:"gw", 5:200000:"" }

# n_events should be passed by the EventProducer
# n_events = 100000

sample_format =  stdhep
$extension_stdhep = "stdhep"
simulate (proc) {checkpoint = 100}
